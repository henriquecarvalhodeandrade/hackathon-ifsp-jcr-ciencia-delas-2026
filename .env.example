# ---------------------------------------------------------------------------
# Ciência Delas — variáveis de ambiente
# Copie para .env.local e preencha. Guia completo: docs/07-setup-e-deploy.md
# ---------------------------------------------------------------------------

# URL pública do site (usada em links de e-mail e redirects de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — `npx supabase status` (local) ou Project Settings > API Keys (cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (service role). SOMENTE servidor: newsletter e cron. Nunca use NEXT_PUBLIC_ aqui.
SUPABASE_SECRET_KEY=sb_secret_xxx

# IA gratuita (opcional — sem chave, o app usa heurísticas e continua funcionando)
# AI_PROVIDER: gemini | groq | openrouter | none  (vazio = usa a primeira chave encontrada)
AI_PROVIDER=
# Google AI Studio (grátis, sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Groq (grátis, sem cartão): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (modelos :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# E-mail da newsletter via Resend (opcional — sem chave, as edições só ficam no arquivo do site)
RESEND_API_KEY=
NEWSLETTER_FROM="Ciência Delas <onboarding@resend.dev>"
# Teto de e-mails por execução do cron (o Resend gratuito permite 100/dia); o resto vai na próxima execução
NEWSLETTER_MAX_PER_RUN=90
# Só em desenvolvimento: sem RESEND_API_KEY, os e-mails vão para o Mailpit do Supabase local.
# Padrão deduzido de NEXT_PUBLIC_SUPABASE_URL (porta 54324). Use "off" para desligar.
# MAILPIT_URL=http://127.0.0.1:54324

# E-mail de contato do projeto (identificação educada na API do Crossref)
CONTACT_EMAIL=contato@cienciadelas.dev

# Protege a rota /api/cron/newsletter (a Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=troque-por-uma-string-aleatoria-longa
